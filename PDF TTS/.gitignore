# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Conteúdo-fonte e conteúdo derivado (copyright / tamanho)
# Os PDFs ficam em input/ apenas na máquina local. Veja input/README.md.
input/*
!input/README.md
content/*
!content/README.md

# Artefatos gerados (áudio, cache, logs)
output/
cache/
logs/
*.log

# Manifests de PDFs arbitrários (ficam locais; os curados são versionados)
manifests/AUTO-*.json

# Arquivos locais do usuário (capturas, rascunhos, etc.)
temp/

# Sistema / editores
.DS_Store
Thumbs.db
.vscode/
.idea/
