# Intermediários e cache local; os arquivos-fonte e entregáveis permanecem versionados.
work/*
!work/.gitkeep
__pycache__/
*.py[cod]

# NENHUM .mp4 é versionado — decisão do usuário (2026-11, reforçada em 2026-11-20):
# o GitHub free não deve carregar vídeo. Brutos E shorts vivem só no disco
# (output/<slug>/video.mp4). Versionam-se apenas textos (meta.md, .srt, roteiros, docs).
*.mp4
/raw/*
!/.gitkeep
