# Intermediários e cache local; os arquivos-fonte e entregáveis permanecem versionados.
work/*
!work/.gitkeep
__pycache__/
*.py[cod]

# Fontes BRUTAS (vídeos de entrada) NÃO são versionadas — decisão do usuário (2026-11):
# o repo fica leve; os brutos vivem só no disco. Entregáveis (output/) continuam versionados.
*.mp4
/Tradução do chinês/*.mp4
/raw/*
!/raw/.gitkeep
